{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "codegen:graphql": "graphql-codegen --config codegen.ts",
    "codegen:graphql:watch": "graphql-codegen --config codegen.ts --watch",
    "codegen:openapi": "npx openapi-typescript http://localhost:5127/openapi/v1.json --enum -o ./src/api/schema.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
