    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.7",
    "axios": "^1.18.1",
    "graphql": "^16.14.2",
    "js-cookie": "^3.0.8",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.86.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.2",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3"
