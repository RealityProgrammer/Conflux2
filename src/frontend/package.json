{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "codegen:graphql": "graphql-codegen --config codegen.ts",
    "codegen:graphql:watch": "graphql-codegen --config codegen.ts --watch",
    "codegen:openapi": "npx -p typescript@^5.x -p openapi-typescript openapi-typescript http://localhost:5127/openapi/v1.json --enum -o ./src/api/schema.ts",
    "codegen": "npm run codegen:graphql && npm run codegen:openapi"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@microsoft/signalr": "^10.0.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "graphql": "^16.0.1",
    "iso8601-duration": "^2.1.4",
    "js-cookie": "^3.0.8",
    "katex": "^0.18.7",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "react-syntax-highlighter": "^16.1.1",
    "react-toastify": "^11.1.0",
    "react-virtuoso": "^4.18.13",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@graphql-codegen/typescript-react-query": "^7.0.5",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "animejs": "^4.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
