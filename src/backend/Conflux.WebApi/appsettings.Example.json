{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=...;Port=...;Database=...;Username=...;Password=...;Include Error Detail=true;Pooling=true;",
    "PostgresCache": "Host=...;Port=...;Database=...;Username=...;Password=...;Pooling=true;MinPoolSize=0;MaxPoolSize=100;Timeout=15;"
  },
  "AllowedHosts": "*"
}
